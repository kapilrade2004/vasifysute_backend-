# ==========================================================
# VasifyTech Suite Backend Environment Configuration
# ==========================================================

PORT=5000
NODE_ENV=development

# ── OPTION 1: Local MySQL Database (Default) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=vt_suite
DB_SSL=false

# ── OPTION 2: Server-Side Remote MySQL (freesqldatabase.com) ──
# DB_HOST=sql12.freesqldatabase.com
# DB_PORT=3306
# DB_USER=sql12836446
# DB_PASSWORD=your_freesqldatabase_password
# DB_NAME=sql12836446
# DB_SSL=false

# ── OPTION 3: Cloud Connection String (TiDB Cloud, Aiven, Railway) ──
# DATABASE_URL=mysql://username:password@gateway.region.tidbcloud.com:4000/vt_suite?ssl={"rejectUnauthorized":true}

# ── Optional: Gmail SMTP Notification Configuration ──
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
